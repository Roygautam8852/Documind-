# Backend-specific environment variables
# See root .env.example for all variables.
# This file is for backend-only overrides during local development.

APP_ENV=development
APP_NAME=DocuMind
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5432/documind

STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt

VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SIMILARITY_THRESHOLD=0.35

AUTH_MODE=jwt
JWT_SECRET=dev-only-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

LOG_LEVEL=DEBUG
