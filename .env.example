# ──────────────────────────────────────────────────────────────────────────────
# DocuMind — Root Environment Variables Example
# Copy this file to .env and fill in the required values.
# NEVER commit the .env file to version control.
# See docs/ENVIRONMENT_VARIABLES.md for full reference.
# ──────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=development
APP_NAME=DocuMind
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database — PostgreSQL
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5432/documind

# File Storage
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt

# Vector Store
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma

# Embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Provider
# Supported: openai, anthropic, google, mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# RAG Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# Authentication
AUTH_MODE=jwt
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Logging
LOG_LEVEL=INFO
